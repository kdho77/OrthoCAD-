<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.orthocad.print-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/OrthoCAD/PrintBridge/node</string>
    <string>/Library/Application Support/OrthoCAD/PrintBridge/bridge.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ORTHOCAD_BRIDGE_ALLOW_LAN_PROBE</key>
    <string>1</string>
    <key>ORTHOCAD_BRIDGE_STATE_DIR</key>
    <string>/Library/Application Support/OrthoCAD/PrintBridge/state</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Library/Logs/OrthoCAD/print-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/OrthoCAD/print-bridge.log</string>
</dict>
</plist>
