<service>
  <id>OrthoCADPrintBridge</id>
  <name>OrthoCAD Print Bridge</name>
  <description>Shop-local OrthoCAD print bridge. It connects outbound only and does not open a console window.</description>
  <executable>%BASE%\node\node.exe</executable>
    <arguments>"%BASE%\bridge.mjs"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <env name="ORTHOCAD_BRIDGE_ALLOW_LAN_PROBE" value="1" />
  <env name="ORTHOCAD_BRIDGE_STATE_DIR" value="%PROGRAMDATA%\OrthoCAD\PrintBridge" />
</service>
