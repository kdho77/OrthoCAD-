{
    "name": "vertex-insole-cad",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": "22.x"
    },
    "description": "Vertex Orthopedic — browser-based orthotic insole CAD (Phase 0 foundation)",
    "scripts": {
        "dev": "vite",
        "build": "python3 ../scripts/materialize-incoming-elements.py && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
        "dev:server": "tsx watch server/src/index.ts",
        "start:server": "tsx server/src/index.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "db:push": "tsx server/src/prisma-cli.ts db push",
        "cleanup:manufacturing-temp": "tsx scripts/cleanup-manufacturing-temp.ts"
    },
    "dependencies": {
        "@kninnug/constrainautor": "^4.1.0",
        "@prisma/client": "^5.22.0",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-tabs": "^1.1.3",
        "@react-three/drei": "^9.114.0",
        "@react-three/fiber": "^8.17.10",
        "@supabase/supabase-js": "^2.46.1",
        "@tanstack/react-query": "^5.59.0",
        "@trpc/client": "^11.0.0-rc.660",
        "@trpc/react-query": "^11.0.0-rc.660",
        "@trpc/server": "^11.0.0-rc.660",
        "class-variance-authority": "^0.7.1",
        "clipper2-ts": "^2.0.1-18",
        "clsx": "^2.1.1",
        "delaunator": "^5.1.0",
        "jszip": "^3.10.1",
        "lucide-react": "^0.456.0",
        "manifold-3d": "^3.5.4",
        "opentype.js": "^2.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "superjson": "^2.2.1",
        "tailwind-merge": "^2.5.4",
        "three": "^0.169.0",
        "three-mesh-bvh": "0.8.0",
        "tsx": "^4.19.2",
        "zod": "^3.23.8",
        "zustand": "^5.0.1"
    },
    "overrides": {
        "three-mesh-bvh": "0.8.0"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/opentype.js": "^1.3.10",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.169.0",
        "@vercel/node": "^5.8.14",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "dotenv": "^16.6.1",
        "postcss": "^8.4.49",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.6.3",
        "vite": "^5.4.11"
    }
}
