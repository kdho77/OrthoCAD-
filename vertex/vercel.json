{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npm install --include=dev",
    "buildCommand": "npm run prisma:generate && npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "functions": {
        "api/trpc/[[...trpc]].ts": {
            "maxDuration": 300,
            "includeFiles": "public/{fonts,elements}/**"
        }
    },
    "rewrites": [
        { "source": "/trpc", "destination": "/api/trpc" },
        { "source": "/trpc/:path*", "destination": "/api/trpc/:path*" },
        {
            "source": "/api/integrations/:path*",
            "destination": "/api/integrations"
        },
        {
            "source": "/print-bridge/:path*",
            "destination": "/api/print-bridge"
        },
        {
            "source": "/((?!api/|trpc/|elements/|Templates/|print-bridge/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/version.json",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
            "source": "/index.html",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        }
    ]
}
