# --- Frontend (Vite) ---
# Leave blank to run in offline dev mode (kdho@vertexorthopedic.com super_admin, 100 tokens).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional — defaults to stock-bases (must match server STOCK_STORAGE_BUCKET)
VITE_STOCK_STORAGE_BUCKET=stock-bases
VITE_API_URL=http://localhost:5181/trpc

# --- Backend / Prisma (Supabase Postgres) ---
# Copy this file to .env, paste DATABASE_URL + DIRECT_URL from Vercel, then run:
#   npm run db:push
# Pooled connection for the app:
DATABASE_URL=postgresql://postgres:password@localhost:5432/vertex?schema=public
# Direct connection for migrations / db push:
DIRECT_URL=postgresql://postgres:password@localhost:5432/vertex?schema=public

# --- tRPC server (server-authoritative export) ---
PORT=5181
CORS_ORIGIN=http://localhost:5180
# Service role key verifies user JWTs and reads/writes token balances server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage bucket for custom GLB assets and scans.
STORAGE_BUCKET=vertex-assets

# --- AI prescription parsing (server-side only; keys never reach the browser) ---
AI_PROVIDER=anthropic        # anthropic | xai
AI_API_KEY=
# Optional model override (defaults: claude-3-5-sonnet-latest / grok-2-vision-1212)
AI_MODEL=

# --- Manufacturing Python service (server-to-server) ---
MANUFACTURING_SERVICE_URL=http://localhost:8000
MANUFACTURING_INTERNAL_API_KEY=dev-manufacturing-key

# --- VertexSlice headless slicer (server-to-server; key never reaches the browser) ---
# Leave VERTEXSLICE_URL unset (or set SLICER_MOCK=1) to use the in-process mock.
VERTEXSLICE_URL=
VERTEXSLICE_API_KEY=
SLICER_MOCK=1

# Pay & download is mocked until Stripe is wired. Keep 1 on preview.
# Set VITE_SLICER_PAY_MOCK=0 only when a live Stripe key is present.
VITE_SLICER_PAY_MOCK=1
SLICER_PAY_MOCK=1
