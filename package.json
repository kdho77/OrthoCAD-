{
    "name": "orthocad",
    "version": "0.7.0-beta",
    "private": true,
    "license": "UNLICENSED",
    "description": "OrthoCAD test harness. Application source is proprietary to Vertex Orthopedic.",
    "documentVersion": "0.7.1",
    "type": "module",
    "engines": {
        "node": "20.x"
    },
    "scripts": {
        "postinstall": "npm install --prefix vertex --include=dev",
        "build": "npm --prefix vertex run build",
        "start": "npm --prefix vertex run preview -- --host 0.0.0.0 --port ${PORT:-4173}",
        "prisma:generate": "npm --prefix vertex run prisma:generate",
        "start:server": "npm --prefix vertex run start:server",
        "check": "biome check --write",
        "format": "biome check --write .",
        "test": "rstest",
        "testc": "rstest --coverage",
        "test:pressure-map-webgl": "rstest --config rstest.webgl.config.ts vertex/tests/pressure-map/pressure-map.webgl.test.ts"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,js,css,json,mjs}": [
            "biome check --write"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@rspack/cli": "^2.0.3",
        "@rspack/core": "^2.0.3",
        "@rspack/dev-server": "^2.0.0",
        "@rstest/core": "^0.10.0",
        "@rstest/coverage-istanbul": "^0.10.0",
        "@types/pngjs": "^6.0.5",
        "happy-dom": "^20.9.0",
        "lint-staged": "^17.0.5",
        "playwright": "^1.64.1",
        "pngjs": "^7.0.0",
        "simple-git-hooks": "2.13.1",
        "ts-checker-rspack-plugin": "^1.3.0",
        "typescript": "^6.0.3",
        "typescript-plugin-css-modules": "^5.2.0"
    },
    "dependencies": {
        "@types/jszip": "^3.4.0",
        "jszip": "^3.10.1"
    }
}
