{
    "name": "orthocad",
    "version": "0.7.0-beta",
    "private": true,
    "license": "UNLICENSED",
    "description": "OrthoCAD test harness. Application source is proprietary to Vertex Orthopedic.",
    "documentVersion": "0.7.1",
    "type": "module",
    "engines": {
        "node": "20.x"
    },
    "scripts": {
        "check": "biome check --write",
        "format": "biome check --write .",
        "test": "rstest",
        "testc": "rstest --coverage"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,js,css,json,mjs}": [
            "biome check --write"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@rspack/cli": "^2.0.3",
        "@rspack/core": "^2.0.3",
        "@rspack/dev-server": "^2.0.0",
        "@rstest/core": "^0.10.0",
        "@rstest/coverage-istanbul": "^0.10.0",
        "happy-dom": "^20.9.0",
        "lint-staged": "^17.0.5",
        "simple-git-hooks": "2.13.1",
        "ts-checker-rspack-plugin": "^1.3.0",
        "typescript": "^6.0.3",
        "typescript-plugin-css-modules": "^5.2.0"
    },
    "dependencies": {
        "@types/jszip": "^3.4.0",
        "jszip": "^3.10.1"
    }
}
